    "CORE_ENABLE_policy": "Two open-drain monitor outputs wired together,10k pull-up toV3V3_D and the existing100k power-page pull-down. Only IO and USB valid permits core buck enable; no ESP firmware is required.",
    "reset_net": "XU_RST_N_1V8",
    "XU_reset_pin": 21,
    "reset_pullup_rail": "V1V8",
    "reset_pullup_ohm": 47000,
    "manual_reset": "Optional NO button pulls XU_RESET_ENABLE to GND;10k series from CORE_ENABLE limits current and preserves core power.",
    "XTAG": "XTAG4 xSYS2 pin10 open-drain reset joins XU_RST_N_1V8; no3.3V push-pull driver.",
    "external_reset_pulse_us_min": 5,
    "CT_delay_formula": "tpd(s)=4*C_CT(uF)+40us (nominal); capacitor charge limits do not replace missing intrinsic timing bounds.",
    "core_IO_ramp_relation": "XMOS allows independent monotonic ramps and recommends no more than50ms separation; this design intentionally establishes IO/USB before enabling core.",
    "runtime_brownout_closed": false,
    "brownout_note": "TPS3897 5mV hysteresis and16us falling delay are typical-only; this circuit does not prove reset always asserts before XU VDD falls below0.855V, nor provide overvoltage protection."
  },
