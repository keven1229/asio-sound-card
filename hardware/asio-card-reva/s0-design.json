  "notes": {
    "project": "ASIO_CARD_USB5V_REV_A",
    "user_decision": "2026-09-16: single USB-C power required; redesign source-current detection and power limiting; procurement selection and price checks paused.",
    "channel_scope": "2 physical mono ADC channels, stereo DAC shared by line/headphone. USB logical 6-in/6-out is a firmware target.",
    "power_scope": "USB Type-C 5V current advertisement. Do not assume host supports higher PD voltage or 3A. Default/1.5A/3A states require explicit load-enable policy. Initial power implementation must be resolved in power-design before wiring those pages.",
    "part_scope": "Known main IC symbols are looked up only to draw verified pins. Ordinary passives carry generic Spec_ID/electrical values; MPN/LCSC procurement decisions deferred. Do not copy supplier identities from placeholder library devices into the procurement BOM.",
    "digital_baseline": "XU316-QF60A C24: VDD/PLL0.900V, all IO1.8V. Bottom61-64 are VDD,65GND. AppPLL MCLK physical14 feedback to physical47; PORT_MCLK_COUNT is not another physical MCLK wire.",
    "mechanical_scope": "Four-layer continuous ground and top-side assembly follow existing project direction. Connector edge positions and exact board dimensions remain to be reviewed with an actual placement proposal before routing. No manufacturing files from a draft.",
    "validation": "Inspect real pin lists, connect against independent pin-net plan, save per page, read back nets, run structural checks/ERC/DRC before PCB transfer.",
    "status": "S0 functional/page organization established. Circuit domains are completed and verified independently before electrical placement/wiring; placeholders are not electrical signoff.",
    "page_revision": "2026-09-16: add XMOS_BOOT and XU_POWER_SEQUENCE before placing their components; original 12-page S0 retained. Current core remains intact."
  }
